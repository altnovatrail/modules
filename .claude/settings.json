{
  "claudeMdExcludes": [
    "**/modules/spec/CLAUDE.md",
    "**/modules/spec/**/CLAUDE.md",
    "**/modules/spec/.claude/rules/**"
  ],
  "autoCompactWindow": 400000,
  "disableClaudeAiConnectors": true,
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": ["${CLAUDE_PROJECT_DIR}/spec/tools/session/main.mjs"]
          }
        ]
      }
    ]
  },
  "permissions": {
    "deny": [
      "Read(modules/*/eval/*)",
      "Read(!modules/*/eval/synthetic-*.json)"
    ]
  }
}
